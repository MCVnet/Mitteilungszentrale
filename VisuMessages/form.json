{
  "elements": [
    {
      "type": "Label",
      "caption": "Meldungen entstehen beim Wechsel von Bedingung nicht erfüllt zu erfüllt. Beim Start oder Speichern werden keine bestehenden Zustände nachgemeldet."
    },
    {
      "type": "List",
      "name": "Rules",
      "caption": "Melderegeln",
      "rowCount": 8,
      "add": true,
      "delete": true,
      "columns": [
        {
          "name": "Enabled",
          "caption": "Aktiv",
          "width": "65px",
          "add": true,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "name": "VariableID",
          "caption": "Variable",
          "width": "220px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "name": "Operator",
          "caption": "Bedingung",
          "width": "140px",
          "add": "eq",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "gleich",
                "value": "eq"
              },
              {
                "caption": "ungleich",
                "value": "ne"
              },
              {
                "caption": "kleiner",
                "value": "lt"
              },
              {
                "caption": "kleiner / gleich",
                "value": "le"
              },
              {
                "caption": "größer",
                "value": "gt"
              },
              {
                "caption": "größer / gleich",
                "value": "ge"
              },
              {
                "caption": "Text enthält",
                "value": "contains"
              }
            ]
          }
        },
        {
          "name": "Value",
          "caption": "Vergleichswert",
          "width": "120px",
          "add": "true",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "name": "Text",
          "caption": "Nachricht",
          "width": "auto",
          "add": "{name}: {value}",
          "edit": {
            "type": "ValidationTextBox"
          }
        }
      ]
    },
    {
      "type": "Label",
      "caption": "Platzhalter: {name} Variablenname, {value} neuer Rohwert, {old} alter Rohwert, {id} Variablen-ID. Boolesche Werte: true/false. Texte: exakte Groß-/Kleinschreibung."
    },
    {
      "type": "NumberSpinner",
      "name": "Limit",
      "caption": "Maximale Anzahl nicht angepinnter Meldungen",
      "minimum": 1,
      "maximum": 5000
    },
    {
      "type": "NumberSpinner",
      "name": "Height",
      "caption": "Höhe der HTML-Box in Pixeln",
      "minimum": 200,
      "maximum": 2000
    },
    {
      "type": "ValidationTextBox",
      "name": "BaseURL",
      "caption": "Symcon-Basisadresse für IPSView, z. B. https://symcon.example.de (leer = relativ)"
    },
    {
      "type": "Label",
      "caption": "Die WebView-Adresse enthält einen geheimen Zugriffsschlüssel. Wer die Adresse kennt, kann Meldungen lesen und bedienen. Bei externer Nutzung HTTPS oder VPN verwenden."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Darstellung: Symbole, Farben und Breite",
      "expanded": true,
      "items": [
        {
          "type": "CheckBox",
          "name": "UseVariableIcons",
          "caption": "Symbole der Variablen übernehmen (sonst Briefsymbol)"
        },
        {
          "type": "NumberSpinner",
          "name": "IconSize",
          "caption": "Symbolgröße (Pixel)",
          "minimum": 24,
          "maximum": 96
        },
        {
          "type": "CheckBox",
          "name": "EmbedSDKIcons",
          "caption": "Symbole direkt einbetten (für IPSView empfohlen)"
        },
        {
          "type": "NumberSpinner",
          "name": "LocalWebPort",
          "caption": "Lokaler Symcon-Webserverport für eingebettete Symbole",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "CheckBox",
          "name": "CustomColors",
          "caption": "Gemeinsame eigene Farben verwenden (sonst automatisch hell/dunkel)"
        },
        {
          "type": "SelectColor",
          "name": "BackgroundColor",
          "caption": "Hintergrundfarbe der Ansicht"
        },
        {
          "type": "SelectColor",
          "name": "MessageColor",
          "caption": "Hintergrundfarbe der Meldungen"
        },
        {
          "type": "SelectColor",
          "name": "TextColor",
          "caption": "Schriftfarbe"
        },
        {
          "type": "SelectColor",
          "name": "AccentColor",
          "caption": "Akzentfarbe (Symbole und „Angepinnt“)"
        },
        {
          "type": "Select",
          "name": "MessageSize",
          "caption": "Breite der Meldungen",
          "options": [
            {
              "caption": "Mini · bis 320 px",
              "value": "mini"
            },
            {
              "caption": "Kompakt · bis 480 px",
              "value": "compact"
            },
            {
              "caption": "Normal · bis 760 px",
              "value": "normal"
            },
            {
              "caption": "Groß · bis 1100 px",
              "value": "large"
            },
            {
              "caption": "Benutzerdefiniert",
              "value": "custom"
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "MessageMinWidth",
          "caption": "Benutzerdefiniert: Mindestbreite (Pixel)",
          "minimum": 120,
          "maximum": 3000
        },
        {
          "type": "NumberSpinner",
          "name": "MessageMaxWidth",
          "caption": "Benutzerdefiniert: Maximalbreite (Pixel)",
          "minimum": 120,
          "maximum": 3000
        },
        {
          "type": "Label",
          "caption": "Breite und Symbolgröße gelten für alle Ansichten. Farben und CSS können je Visu eingestellt werden. Bestehende gemeinsame Farben bleiben erhalten."
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben und CSS: WebFront",
          "items": [
            {
              "type": "CheckBox",
              "name": "WebFrontOwnColors",
              "caption": "Eigene Farben für WebFront verwenden (sonst gemeinsame Vorgabe)"
            },
            {
              "type": "SelectColor",
              "name": "WebFrontBackgroundColor",
              "caption": "Hintergrundfarbe der Ansicht (ohne Farbe = transparent)"
            },
            {
              "type": "SelectColor",
              "name": "WebFrontMessageColor",
              "caption": "Hintergrundfarbe der Meldungen"
            },
            {
              "type": "SelectColor",
              "name": "WebFrontTextColor",
              "caption": "Schriftfarbe"
            },
            {
              "type": "SelectColor",
              "name": "WebFrontAccentColor",
              "caption": "Akzentfarbe (Symbole und Angepinnt)"
            },
            {
              "type": "ValidationTextBox",
              "name": "WebFrontCSS",
              "caption": "Optionales CSS für WebFront",
              "multiline": true,
              "width": "100%"
            },
            {
              "type": "Label",
              "caption": "CSS-Variablen: --bg, --card, --text, --accent. Farbfelder haben Vorrang vor CSS-Variablen; für direkte CSS-Anpassungen z. B. body { background: #071526; } verwenden."
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben und CSS: IPSView",
          "items": [
            {
              "type": "CheckBox",
              "name": "IPSViewOwnColors",
              "caption": "Eigene Farben für IPSView verwenden (sonst gemeinsame Vorgabe)"
            },
            {
              "type": "SelectColor",
              "name": "IPSViewBackgroundColor",
              "caption": "Hintergrundfarbe der Ansicht (ohne Farbe = transparent)"
            },
            {
              "type": "SelectColor",
              "name": "IPSViewMessageColor",
              "caption": "Hintergrundfarbe der Meldungen"
            },
            {
              "type": "SelectColor",
              "name": "IPSViewTextColor",
              "caption": "Schriftfarbe"
            },
            {
              "type": "SelectColor",
              "name": "IPSViewAccentColor",
              "caption": "Akzentfarbe (Symbole und Angepinnt)"
            },
            {
              "type": "ValidationTextBox",
              "name": "IPSViewCSS",
              "caption": "Optionales CSS für IPSView",
              "multiline": true,
              "width": "100%"
            },
            {
              "type": "Label",
              "caption": "CSS-Variablen: --bg, --card, --text, --accent. Farbfelder haben Vorrang vor CSS-Variablen; für direkte CSS-Anpassungen z. B. body { background: #071526; } verwenden."
            },
            {
              "type": "Label",
              "caption": "Falls Transparenz im IPSView-Client weiß erscheint, hier die passende Hintergrundfarbe der IPSView-Seite setzen."
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben und CSS: Kachelvisu",
          "items": [
            {
              "type": "CheckBox",
              "name": "TileOwnColors",
              "caption": "Eigene Farben für Kachelvisu verwenden (sonst gemeinsame Vorgabe)"
            },
            {
              "type": "SelectColor",
              "name": "TileBackgroundColor",
              "caption": "Hintergrundfarbe der Ansicht (ohne Farbe = transparent)"
            },
            {
              "type": "SelectColor",
              "name": "TileMessageColor",
              "caption": "Hintergrundfarbe der Meldungen"
            },
            {
              "type": "SelectColor",
              "name": "TileTextColor",
              "caption": "Schriftfarbe"
            },
            {
              "type": "SelectColor",
              "name": "TileAccentColor",
              "caption": "Akzentfarbe (Symbole und Angepinnt)"
            },
            {
              "type": "ValidationTextBox",
              "name": "TileCSS",
              "caption": "Optionales CSS für Kachelvisu",
              "multiline": true,
              "width": "100%"
            },
            {
              "type": "Label",
              "caption": "CSS-Variablen: --bg, --card, --text, --accent. Farbfelder haben Vorrang vor CSS-Variablen; für direkte CSS-Anpassungen z. B. body { background: #071526; } verwenden."
            }
          ]
        },
        {
          "type": "Select",
          "name": "SDKColorProfile",
          "caption": "Profil für TileHtml / HTML-SDK",
          "options": [
            {
              "caption": "Automatisch: eigenständige Ansicht = IPSView, iframe = Kachelvisu",
              "value": "auto"
            },
            {
              "caption": "Immer IPSView (Sonderfall / anderer Client)",
              "value": "ipsview"
            },
            {
              "caption": "Immer Kachelvisu (Sonderfall / anderer Client)",
              "value": "tile"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Diagnose: Transparenz in IPSView",
      "items": [
        {
          "type": "CheckBox",
          "name": "TransparencyTest",
          "caption": "Minimalen Transparenztest statt der TileHtml-Meldungsliste anzeigen"
        },
        {
          "type": "Label",
          "caption": "Nach Übernehmen die View im IPSView-Client neu laden. A soll den Seitenhintergrund zeigen; B ist absichtlich dunkelblau. Der Test betrifft auch die Kachelvisu dieser Instanz. Meldungen werden weiter gesammelt und bleiben erhalten. Danach Haken entfernen, übernehmen und View erneut laden."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Testmeldung erzeugen",
      "onClick": "VMMSG_AddTestMessage($id);"
    },
    {
      "type": "Button",
      "caption": "WebView-Zugriffsschlüssel erneuern",
      "onClick": "VMMSG_RotateAccessKey($id);"
    }
  ],
  "status": [
    {
      "code": 200,
      "icon": "error",
      "caption": "Ungültige Melderegel oder Einstellung – siehe Konfigurationshinweis"
    }
  ]
}
