{
  "elements": [
    {
      "type": "List",
      "name": "Rules",
      "caption": "Melderegeln und Variablen",
      "rowCount": 16,
      "add": true,
      "delete": true,
      "columns": [
        {
          "name": "Enabled",
          "caption": "Aktiv",
          "width": "55px",
          "add": true,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "name": "VariableID",
          "caption": "Variable",
          "width": "420px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "name": "Operator",
          "caption": "Bedingung",
          "width": "135px",
          "add": "eq",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "gleich",
                "value": "eq"
              },
              {
                "caption": "ungleich",
                "value": "ne"
              },
              {
                "caption": "kleiner",
                "value": "lt"
              },
              {
                "caption": "kleiner / gleich",
                "value": "le"
              },
              {
                "caption": "größer",
                "value": "gt"
              },
              {
                "caption": "größer / gleich",
                "value": "ge"
              },
              {
                "caption": "Text enthält",
                "value": "contains"
              }
            ]
          }
        },
        {
          "name": "Value",
          "caption": "Vergleichswert",
          "width": "110px",
          "add": "true",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "name": "Text",
          "caption": "Nachricht",
          "width": "auto",
          "add": "{name}: {value}",
          "edit": {
            "type": "ValidationTextBox"
          }
        }
      ],
      "width": "100%"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Hinweise zu Melderegeln und Platzhaltern",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Meldungen entstehen beim Wechsel von Bedingung nicht erfüllt zu erfüllt. Beim Start oder Speichern werden keine bestehenden Zustände nachgemeldet."
        },
        {
          "type": "Label",
          "caption": "Platzhalter: {name} Variablenname, {value} neuer Rohwert, {old} alter Rohwert, {id} Variablen-ID. Boolesche Werte: true/false. Texte: exakte Groß-/Kleinschreibung."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Einstellungen",
      "expanded": false,
      "items": [
        {
          "type": "ExpansionPanel",
          "caption": "Speicher und Begrenzung",
          "expanded": false,
          "items": [
            {
              "type": "NumberSpinner",
              "name": "Limit",
              "caption": "Maximale Anzahl nicht angepinnter Meldungen",
              "minimum": 1,
              "maximum": 5000,
              "width": "350px"
            },
            {
              "type": "Label",
              "caption": "Angepinnte Meldungen bleiben erhalten und zählen nicht zum Limit."
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Modulvariablen und Daten",
          "expanded": false,
          "items": [
            {
              "type": "CheckBox",
              "name": "ShowModuleData",
              "caption": "Modulvariablen und Daten im Objektbaum anzeigen"
            },
            {
              "type": "Label",
              "caption": "Zeigt die WebView-Adresse, die Gesamtzahl, angepinnte und nicht angepinnte Meldungen sowie Meldungsdaten als JSON. Nach Änderungen übernehmen sind die Variablen unter dieser Instanz sichtbar. Die Daten werden automatisch aktualisiert."
            },
            {
              "type": "Label",
              "caption": "Die JSON-Daten sind eine Ausgabe zur Weiterverwendung. Änderungen daran ändern nicht die gespeicherten Meldungen. Die WebView-Adresse enthält den Zugriffsschlüssel."
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Darstellung · Symbole und Größe",
          "expanded": false,
          "items": [
            {
              "type": "CheckBox",
              "name": "UseVariableIcons",
              "caption": "Symbole der Variablen übernehmen (sonst Briefsymbol)"
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "NumberSpinner",
                  "name": "IconSize",
                  "caption": "Symbolgröße (Pixel)",
                  "minimum": 24,
                  "maximum": 96,
                  "width": "180px"
                },
                {
                  "type": "Select",
                  "name": "MessageSize",
                  "caption": "Breite der Meldungen",
                  "options": [
                    {
                      "caption": "Mini · bis 320 px",
                      "value": "mini"
                    },
                    {
                      "caption": "Kompakt · bis 480 px",
                      "value": "compact"
                    },
                    {
                      "caption": "Normal · bis 760 px",
                      "value": "normal"
                    },
                    {
                      "caption": "Groß · bis 1100 px",
                      "value": "large"
                    },
                    {
                      "caption": "Benutzerdefiniert",
                      "value": "custom"
                    }
                  ],
                  "width": "260px"
                }
              ]
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "NumberSpinner",
                  "name": "MessageMinWidth",
                  "caption": "Benutzerdefiniert: Mindestbreite (Pixel)",
                  "minimum": 120,
                  "maximum": 3000,
                  "width": "220px"
                },
                {
                  "type": "NumberSpinner",
                  "name": "MessageMaxWidth",
                  "caption": "Benutzerdefiniert: Maximalbreite (Pixel)",
                  "minimum": 120,
                  "maximum": 3000,
                  "width": "220px"
                }
              ]
            },
            {
              "type": "NumberSpinner",
              "name": "Height",
              "caption": "HTML-Box: Höhe (Pixel)",
              "minimum": 200,
              "maximum": 2000,
              "width": "220px"
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben · Gemeinsame Vorgabe",
          "expanded": false,
          "items": [
            {
              "type": "Label",
              "caption": "Gilt für alle Visualisierungen, solange dort keine eigenen Farben aktiviert sind."
            },
            {
              "type": "CheckBox",
              "name": "CustomColors",
              "caption": "Eigene Vorgabefarben verwenden (sonst automatisch hell/dunkel)"
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "BackgroundColor",
                  "caption": "Ansicht",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "MessageColor",
                  "caption": "Meldung",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "TextColor",
                  "caption": "Schrift",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "AccentColor",
                  "caption": "Akzent / Symbole",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben · WebFront",
          "expanded": false,
          "items": [
            {
              "type": "CheckBox",
              "name": "WebFrontOwnColors",
              "caption": "Eigene Farben verwenden"
            },
            {
              "type": "Label",
              "caption": "Ausgeschaltet: gemeinsame Vorgabe. Eingeschaltet: die vier Farben unten."
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "WebFrontBackgroundColor",
                  "caption": "Ansicht",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "WebFrontMessageColor",
                  "caption": "Meldung",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "WebFrontTextColor",
                  "caption": "Schrift",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "WebFrontAccentColor",
                  "caption": "Akzent / Symbole",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "ExpansionPanel",
              "caption": "Erweitert · CSS",
              "expanded": false,
              "items": [
                {
                  "type": "ValidationTextBox",
                  "name": "WebFrontCSS",
                  "caption": "Eigenes CSS",
                  "multiline": true,
                  "width": "100%"
                },
                {
                  "type": "Label",
                  "caption": "Optional, gilt nur für diese Visualisierung. Beispiel: article { border-radius: 16px; }. Die Farbfelder haben Vorrang vor CSS-Variablen."
                }
              ]
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben · IPSView",
          "expanded": false,
          "items": [
            {
              "type": "CheckBox",
              "name": "IPSViewOwnColors",
              "caption": "Eigene Farben verwenden"
            },
            {
              "type": "Label",
              "caption": "Ausgeschaltet: gemeinsame Vorgabe. Eingeschaltet: die vier Farben unten."
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "IPSViewBackgroundColor",
                  "caption": "Ansicht",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "IPSViewMessageColor",
                  "caption": "Meldung",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "IPSViewTextColor",
                  "caption": "Schrift",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "IPSViewAccentColor",
                  "caption": "Akzent / Symbole",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "ExpansionPanel",
              "caption": "Erweitert · CSS",
              "expanded": false,
              "items": [
                {
                  "type": "ValidationTextBox",
                  "name": "IPSViewCSS",
                  "caption": "Eigenes CSS",
                  "multiline": true,
                  "width": "100%"
                },
                {
                  "type": "Label",
                  "caption": "Optional, gilt nur für diese Visualisierung. Beispiel: article { border-radius: 16px; }. Die Farbfelder haben Vorrang vor CSS-Variablen."
                }
              ]
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Farben · Kachelvisu",
          "expanded": false,
          "items": [
            {
              "type": "CheckBox",
              "name": "TileOwnColors",
              "caption": "Eigene Farben verwenden"
            },
            {
              "type": "Label",
              "caption": "Ausgeschaltet: gemeinsame Vorgabe. Eingeschaltet: die vier Farben unten."
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "TileBackgroundColor",
                  "caption": "Ansicht",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "TileMessageColor",
                  "caption": "Meldung",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "SelectColor",
                  "name": "TileTextColor",
                  "caption": "Schrift",
                  "allowTransparent": false,
                  "width": "300px"
                },
                {
                  "type": "SelectColor",
                  "name": "TileAccentColor",
                  "caption": "Akzent / Symbole",
                  "allowTransparent": false,
                  "width": "300px"
                }
              ]
            },
            {
              "type": "ExpansionPanel",
              "caption": "Erweitert · CSS",
              "expanded": false,
              "items": [
                {
                  "type": "ValidationTextBox",
                  "name": "TileCSS",
                  "caption": "Eigenes CSS",
                  "multiline": true,
                  "width": "100%"
                },
                {
                  "type": "Label",
                  "caption": "Optional, gilt nur für diese Visualisierung. Beispiel: article { border-radius: 16px; }. Die Farbfelder haben Vorrang vor CSS-Variablen."
                }
              ]
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Erweitert · Einbindung",
          "expanded": false,
          "items": [
            {
              "type": "ValidationTextBox",
              "name": "BaseURL",
              "caption": "Symcon-Basisadresse für IPSView, z. B. https://symcon.example.de (leer = relativ)",
              "width": "100%"
            },
            {
              "type": "CheckBox",
              "name": "EmbedSDKIcons",
              "caption": "Symbole direkt einbetten (für IPSView empfohlen)"
            },
            {
              "type": "NumberSpinner",
              "name": "LocalWebPort",
              "caption": "Lokaler Symcon-Webserverport für eingebettete Symbole",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "Select",
              "name": "SDKColorProfile",
              "caption": "Profil für TileHtml / HTML-SDK",
              "options": [
                {
                  "caption": "Automatisch: eigenständige Ansicht = IPSView, iframe = Kachelvisu",
                  "value": "auto"
                },
                {
                  "caption": "Immer IPSView (Sonderfall / anderer Client)",
                  "value": "ipsview"
                },
                {
                  "caption": "Immer Kachelvisu (Sonderfall / anderer Client)",
                  "value": "tile"
                }
              ]
            },
            {
              "type": "Label",
              "caption": "Die WebView-Adresse enthält einen geheimen Zugriffsschlüssel. Wer die Adresse kennt, kann Meldungen lesen und bedienen. Bei externer Nutzung HTTPS oder VPN verwenden."
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Testmeldung erzeugen",
      "onClick": "VMMSG_AddTestMessage($id);"
    },
    {
      "type": "Button",
      "caption": "WebView-Zugriffsschlüssel erneuern",
      "onClick": "VMMSG_RotateAccessKey($id);"
    }
  ],
  "status": [
    {
      "code": 200,
      "icon": "error",
      "caption": "Ungültige Melderegel oder Einstellung – siehe Konfigurationshinweis"
    }
  ]
}
